#include <stdio.h>

int main() {
    int num1, num2, soma;

    // Lendo o primeiro número
    printf("Digite o primeiro numero inteiro: ");
    scanf("%d", &num1);

    // Lendo o segundo número
    printf("Digite o segundo numero inteiro: ");
    scanf("%d", &num2);

    // Realizando a soma
    soma = num1 + num2;

    // Exibindo o resultado
    printf("A soma de %d e %d eh: %d\n", num1, num2, soma);

    return 0;
}
