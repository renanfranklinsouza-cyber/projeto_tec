#include <stdio.h>

int main() {
    int num;

    // Lendo o número inteiro
    printf("Digite um numero inteiro: ");
    scanf("%d", &num);

    // Verificando se é par ou ímpar
    if (num % 2 == 0) {
        printf("O numero %d eh par.\n", num);
    } else {
        printf("O numero %d eh impar.\n", num);
    }

    return 0;
}
